                <div className="space-y-4">
                    {publications?.map((pub) => (
                        <PublicationCard
                            key={pub.id}
                            pub={pub}
                            variant="list"
                            showStatus
                            status="published"
                        />
                    ))}
                </div>
            </section>
        </div>
    );
};
