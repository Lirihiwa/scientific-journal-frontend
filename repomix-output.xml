<file path="src/index.css">
@import "tailwindcss";

/* 1. НАСТРОЙКА ТЕМЫ TAILWIND V4 */
@theme {
    /* Типографика: строгая и академичная */
    --font-sans: "Inter", system-ui, -apple-system, sans-serif;
    --font-serif: "Merriweather", "Times New Roman", serif;
    --font-heading: "Playfair Display", "Georgia", serif;
    --font-accent: "JetBrains Mono", "Courier New", monospace;

    /* Семантические цвета (связь с CSS-переменными) */
    --color-background: var(--background);
    --color-foreground: var(--foreground);

    --color-card: var(--card);
    --color-card-foreground: var(--card-foreground);

    --color-popover: var(--popover);
    --color-popover-foreground: var(--popover-foreground);

    --color-primary: var(--primary);
    --color-primary-foreground: var(--primary-foreground);
    --color-primary-hover: var(--primary-hover);

    --color-secondary: var(--secondary);
    --color-secondary-foreground: var(--secondary-foreground);

    --color-muted: var(--muted);
    --color-muted-foreground: var(--muted-foreground);

    --color-accent: var(--accent);
    --color-accent-foreground: var(--accent-foreground);

    --color-destructive: var(--destructive);
    --color-destructive-foreground: var(--destructive-foreground);

    --color-border: var(--border);
    --color-input: var(--input);
    --color-ring: var(--ring);

    /* 🆕 Статусные цвета (Жизненный цикл заявок) */
    --color-status-new: var(--status-new);
    --color-status-review: var(--status-review);
    --color-status-revision: var(--status-revision);
    --color-status-accepted: var(--status-accepted);
    --color-status-rejected: var(--status-rejected);
    --color-status-published: var(--status-published);

    /* Строгие радиусы для научного стиля */
    --radius-sm: calc(var(--radius) - 2px);
    --radius-md: var(--radius);
    --radius-lg: calc(var(--radius) + 2px);
    --radius-full: 9999px;

    /* Анимации для скелетонов и модалок */
    --animate-fade-in: fade-in 0.3s ease-out;
    --animate-fade-in-up: fade-in-up 0.4s ease-out;
    --animate-skeleton: skeleton-pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
}

/* 2. CSS ПЕРЕМЕННЫЕ (СВЕТЛАЯ / ТЕМНАЯ ТЕМА) */
@layer base {
    :root {
        /* Основные цвета подложки и текста */
        --background: #fafafa;
        --foreground: #111827;

        /* Карточки и выпадающие списки */
        --card: #ffffff;
        --card-foreground: #111827;
        --popover: #ffffff;
        --popover-foreground: #111827;

        /* Primary (Фирменный бордовый) */
        --primary: #800000;
        --primary-foreground: #ffffff;
        --primary-hover: #660000;

        /* Secondary (Для менее акцентных кнопок и блоков) */
        --secondary: #f3f4f6;
        --secondary-foreground: #1f2937;

        /* Muted (Неактивные элементы, плашки, второстепенный текст) */
        --muted: #f4f4f5;
        --muted-foreground: #71717a;

        /* Accent (Золотой/Бронзовый для акцентов или DOI) */
        --accent: #b8860b;
        --accent-foreground: #ffffff;

        /* Destructive (Ошибки, удаление) */
        --destructive: #991b1b;
        --destructive-foreground: #fef2f2;

        /* Границы и инпуты */
        --border: #e4e4e7;
        --input: #e4e4e7;
        --ring: #800000;

        /* 🆕 Статусы жизненного цикла (Light) */
        --status-new: #0369a1;       /* sky-700 */
        --status-review: #b45309;    /* amber-700 */
        --status-revision: #c2410c;  /* orange-700 */
        --status-accepted: #15803d;  /* green-700 */
        --status-rejected: #b91c1c;  /* red-700 */
        --status-published: #4f46e5; /* indigo-600 */

        /* Базовый радиус (строгий стиль) */
        --radius: 0.125rem; /* 2px */
    }

    /* Темная тема (готово к использованию) */
    .dark {
        --background: #09090b;
        --foreground: #fafafa;

        --card: #121214;
        --card-foreground: #fafafa;
        --popover: #121214;
        --popover-foreground: #fafafa;

        --primary: #a32222;
        --primary-foreground: #ffffff;
        --primary-hover: #c43333;

        --secondary: #27272a;
        --secondary-foreground: #fafafa;

        --muted: #27272a;
        --muted-foreground: #a1a1aa;

        --accent: #d4af37;
        --accent-foreground: #09090b;

        --destructive: #7f1d1d;
        --destructive-foreground: #fef2f2;

        --border: #27272a;
        --input: #27272a;
        --ring: #a32222;

        /* 🆕 Статусы жизненного цикла (Dark) */
        --status-new: #7dd3fc;       /* sky-300 */
        --status-review: #fbbf24;    /* amber-400 */
        --status-revision: #fb923c;  /* orange-400 */
        --status-accepted: #4ade80;  /* green-400 */
        --status-rejected: #f87171;  /* red-400 */
        --status-published: #818cf8; /* indigo-400 */
    }
}

/* 3. ГЛОБАЛЬНЫЕ БАЗОВЫЕ СТИЛИ */
@layer base {
    * {
        @apply border-border outline-ring/50;
    }
    body {
        @apply bg-background text-foreground font-sans antialiased;
        font-feature-settings: "rlig" 1, "calt" 1;
    }

    /* Заголовки по умолчанию */
    h1, h2, h3, h4, h5, h6 {
        @apply font-heading tracking-tight;
    }
}

/* 4. КАСТОМНЫЕ УТИЛИТЫ И АНИМАЦИИ */
@layer utilities {
    @keyframes skeleton-pulse {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.4; }
    }
    @keyframes fade-in {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    @keyframes fade-in-up {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }

    /* Академический скроллбар */
    .scrollbar-academic::-webkit-scrollbar {
        width: 6px;
        height: 6px;
    }
    .scrollbar-academic::-webkit-scrollbar-track {
        @apply bg-muted;
    }
    .scrollbar-academic::-webkit-scrollbar-thumb {
        @apply bg-primary/40 rounded-full hover:bg-primary/60 transition-colors;
    }
}
